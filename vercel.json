{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run data:fetch && npm run build:web",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/world",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/world/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
