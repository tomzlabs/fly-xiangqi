{
  "name": "fly-xiangqi-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:wasm && vite build",
    "build:web": "vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "data": "python scripts/prepare_data.py",
    "test": "cargo test --manifest-path native/Cargo.toml && node --test tests/*.test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:brian2": "python scripts/verify_brian2.py",
    "test:rules": "node --test tests/*.test.mjs",
    "data:fetch": "node scripts/fetch-data.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "7.3.6"
  },
  "engines": {
    "node": "22.x"
  }
}
