{
  "name": "fly-world",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:wasm && vite build",
    "build:web": "vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "data": "python scripts/prepare_data.py",
    "test": "cargo test --manifest-path native/Cargo.toml && node --test tests/*.test.mjs",
    "benchmark": "node scripts/check-world.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:brian2": "python scripts/verify_brian2.py",
    "data:fetch": "node scripts/fetch-data.mjs",
    "test:world": "node scripts/check-world.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "bs58": "^6.0.0",
    "qrcode": "^1.5.4",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "playwright": "^1.63.0",
    "vite": "7.3.6"
  },
  "engines": {
    "node": "22.x"
  }
}
